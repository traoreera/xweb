<!--
    Landing page — la racine "/" du site (docs/shell.md, xweb/mount.py).
    Montée depuis main.py (aucun plugin ne peut servir "/" lui-même — voir
    integration.yaml, commentaire sur namespaces.site), dans
    xweb.marketing_layout (components/layout.xml) : pas le chrome interne
    de l'appli (pas encore "dans" xweb), pas non plus la carte étroite des
    écrans d'auth — une vraie page d'accueil pleine largeur.

    `user`/`account` viennent du contexte auto-injecté par
    render_xweb_template (xweb/mount.py::_base_render_context) — cette page
    n'a pas besoin de les recevoir explicitement de sa vue. `_`/`locale`
    idem (docs/i18n.md) — page de premier niveau, jamais besoin de les
    repasser explicitement à un t-call (contrairement à un composant
    partagé comme account.auth_card, dont le contexte est isolé).

    Les composants xweb.* (card/stat/badge/button) sont génériques,
    partagés par tout plugin — jamais de _() À L'INTÉRIEUR d'eux : chaque
    prop texte est traduit ICI, au site d'appel, avant d'être passé.
-->
<template t-name="site.landing">
<div class="flex flex-col">

    <!-- ── hero ──────────────────────────────────────────────────────── -->
    <section class="px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
        <div class="max-w-3xl mx-auto text-center flex flex-col items-center gap-6">
            <t t-call="xweb.badge" color="primary" size="md" variant="soft">
                <t t-call="xweb.icon" name="sparkles" extra_class="size-3.5"/>xcoreruntime · QWeb · htmx
            </t>
            <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-balance" t-tr="1">
                Des pages server-rendues qui s'étendent sans se forker.
            </h1>
            <!-- Phrase à markup mixte (t-esc + <span> inline) — hors de la
                portée simple de t-tr/_() (ni l'un ni l'autre ne gère du
                HTML incrusté sans risquer une traduction fragile côté
                catalogue). Reste en français pour l'instant, comme
                documenté pour le reste de l'appli non encore retrofit
                (docs/i18n.md, docs/components.md pour le précédent avec
                les composants). -->
            <p class="text-lg opacity-70 max-w-xl text-balance">
                <t t-esc="app_name"/> assemble un moteur de templates QWeb, un shell persistant
                façon Obsidian et une authentification d'entreprise complète — pour des plugins
                <span class="font-mono text-sm">xcore</span> qui composent leurs pages au lieu de
                les dupliquer.
            </p>
            <div class="flex flex-wrap items-center justify-center gap-3 mt-2">
                <t t-if="user">
                    <t t-call="xweb.button" variant="primary" size="lg" t-att-href="'#composants'" extra_class="gap-2">
                        <t t-call="xweb.icon" name="arrow_right" extra_class="size-5"/><t t-esc="_('Aller à la démo')"/>
                    </t>
                    <t t-call="xweb.button" variant="outline" size="lg" t-att-href="account_path" extra_class=""><t t-esc="_('Mon compte')"/></t>
                </t>
                <t t-else="1">
                    <t t-call="xweb.button" variant="primary" size="lg" t-att-href="login_url" extra_class="gap-2">
                        <t t-call="xweb.icon" name="login" extra_class="size-5"/><t t-esc="_('Se connecter')"/>
                    </t>
                    <t t-call="xweb.button" variant="outline" size="lg" t-att-href="'#composants'" extra_class=""><t t-esc="_('Voir la démo sans compte')"/></t>
                </t>
            </div>
            <t t-if="user">
                <p class="text-sm opacity-60">
                    <t t-esc="_('Connecté en tant que')"/> <span class="font-medium"><t t-esc="account['label']"/></span>.
                </p>
            </t>
        </div>
    </section>

    <!-- ── chiffres ──────────────────────────────────────────────────── -->
    <section class="px-4 sm:px-6 lg:px-8 pb-16">
        <div class="max-w-4xl mx-auto grid grid-cols-2 sm:grid-cols-4 gap-4">
            <t t-call="xweb.stat" t-att-title="_('Régions du shell')" value="4" t-att-desc="_('+ palette Ctrl+K')" icon="panel"/>
            <t t-call="xweb.stat" t-att-title="_('Composants DaisyUI')" value="30+" t-att-desc="_('xweb.*, tous en XML')" icon="grid"/>
            <t t-call="xweb.stat" t-att-title="_('JS écrit à la main')" value="1" t-att-desc="_('ligne (anti-flash de thème)')" icon="bolt"/>
            <t t-call="xweb.stat" t-att-title="_('Endpoints d\'auth')" value="13" t-att-desc="_('RBAC, MFA, OAuth, multi-tenant')" icon="shield"/>
        </div>
    </section>

    <!-- ── fonctionnalités ───────────────────────────────────────────── -->
    <section class="px-4 sm:px-6 lg:px-8 pb-20">
        <div class="max-w-5xl mx-auto">
            <div class="text-center mb-10">
                <h2 class="text-2xl sm:text-3xl font-bold" t-tr="1">Tout ce qu'il faut pour une vraie application</h2>
                <p class="opacity-70 mt-2" t-tr="1">Pas un squelette de démo qu'il faut ensuite câbler soi-même.</p>
            </div>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                <t t-call="xweb.card" t-att-title="_('Héritage non-destructif')" extra_class="h-full">
                    <p class="text-sm opacity-80" t-tr="1">
                        t-inherit + XPath : un plugin étend la page ou
                        le composant d'un autre sans le forker. Conflits résolus au boot, jamais en
                        exception à l'exécution.
                    </p>
                </t>
                <t t-call="xweb.card" t-att-title="_('Shell persistant')" extra_class="h-full">
                    <p class="text-sm opacity-80" t-tr="1">
                        Nav, ruban, palette de commandes et barre d'état — chaque plugin y contribue
                        au chargement via de simples registres, sans redessiner sa propre page à
                        chaque fois.
                    </p>
                </t>
                <t t-call="xweb.card" title="htmx + _hyperscript" extra_class="h-full">
                    <p class="text-sm opacity-80" t-tr="1">
                        Interactivité serveur et client sans étape de build JavaScript — un attribut
                        HTML de plus, jamais un bundle à compiler ni un framework à charger.
                    </p>
                </t>
                <t t-call="xweb.card" t-att-title="_('Thème clair / sombre')" extra_class="h-full">
                    <p class="text-sm opacity-80" t-tr="1">
                        DaisyUI via data-theme, persisté en
                        localStorage et appliqué avant le premier
                        rendu — jamais de flash du mauvais thème.
                    </p>
                </t>
                <t t-call="xweb.card" t-att-title="_('Authentification d\'entreprise')" extra_class="h-full">
                    <p class="text-sm opacity-80" t-tr="1">
                        Multi-tenant, RBAC, MFA TOTP, OAuth, invitations, audit log — un vrai backend
                        d'auth JSON, avec un pont HTML complet devant (connexion, profil, sécurité,
                        sessions).
                    </p>
                </t>
                <t t-call="xweb.card" t-att-title="_('Sécurité par défaut')" extra_class="h-full">
                    <p class="text-sm opacity-80" t-tr="1">
                        CSRF, en-têtes de sécurité et CSP câblés dans l'application réelle — pas
                        seulement testés en isolation, vérifiés en direct sur ce serveur.
                    </p>
                </t>
            </div>
        </div>
    </section>

    <!-- ── stack ─────────────────────────────────────────────────────── -->
    <section class="px-4 sm:px-6 lg:px-8 pb-20">
        <div class="max-w-3xl mx-auto text-center flex flex-col items-center gap-4">
            <h2 class="text-lg font-semibold opacity-80" t-tr="1">Pile technique</h2>
            <div class="flex flex-wrap items-center justify-center gap-2">
                <t t-call="xweb.badge" color="neutral" size="md">QWeb / lxml</t>
                <t t-call="xweb.badge" color="neutral" size="md">FastAPI</t>
                <t t-call="xweb.badge" color="neutral" size="md">htmx</t>
                <t t-call="xweb.badge" color="neutral" size="md">_hyperscript</t>
                <t t-call="xweb.badge" color="neutral" size="md">Tailwind v4</t>
                <t t-call="xweb.badge" color="neutral" size="md">DaisyUI 5</t>
                <t t-call="xweb.badge" color="neutral" size="md">SQLAlchemy async</t>
                <t t-call="xweb.badge" color="neutral" size="md">JWT RS256</t>
            </div>
        </div>
    </section>

    <!-- ── catalogue de composants ───────────────────────────────────── -->
    <t t-call="site.components_catalogue" t-att-showcase="showcase" t-att-csrf_token="csrf_token"/>

    <!-- ── CTA final ─────────────────────────────────────────────────── -->
    <section class="px-4 sm:px-6 lg:px-8 pb-20">
        <div class="max-w-3xl mx-auto">
            <t t-call="xweb.card" extra_class="bg-primary text-primary-content">
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
                    <div>
                        <h2 class="text-xl font-semibold" t-tr="1">Prêt à explorer ?</h2>
                        <p class="opacity-90 text-sm mt-1" t-tr="1">La démo montre le shell, l'htmx et les composants en action.</p>
                    </div>
                    <t t-call="xweb.button" variant="neutral" size="md" t-att-href="'#composants'" extra_class="shrink-0"><t t-esc="_('Ouvrir la démo')"/></t>
                </div>
            </t>
        </div>
    </section>

</div>
</template>
