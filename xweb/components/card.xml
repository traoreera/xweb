<template t-name="xweb.card">
    <t t-set="padding" t-default="'md'"/>
    <t t-set="variant" t-default="'raised'"/>
    <t t-set="title" t-default="''"/>
    <t t-set="subheading" t-default="''"/>
    <t t-set="header" t-default="''"/>
    <t t-set="extra_class" t-default="''"/>
    <t t-set="variant_class"
       t-value="'bg-base-100 shadow-sm border border-base-200' if variant == 'raised' else 'card-border bg-base-100'"/>
    <t t-set="padding_class"
       t-value="{'none': '', 'xs': 'p-2', 'sm': 'p-4', 'md': 'p-6', 'lg': 'p-8', 'xl': 'p-10', '2xl': 'p-12'}[padding]"/>
    <t t-if="title or subheading or header">
        <div t-attf-class="card rounded-box {{variant_class}} {{extra_class}}">
            <div class="px-6 py-4 border-b border-base-200">
                <t t-if="title"><h3 class="card-title"><t t-esc="title"/></h3></t>
                <t t-if="subheading">
                    <p t-attf-class="text-sm opacity-70 {{ 'mt-0.5' if title else '' }}"><t t-esc="subheading"/></p>
                </t>
                <t t-if="header"><t t-out="header"/></t>
            </div>
            <div t-attf-class="{{padding_class}}"><t t-out="slot"/></div>
        </div>
    </t>
    <t t-else="1">
        <div t-attf-class="card rounded-box {{variant_class}} {{padding_class}} {{extra_class}}">
            <t t-out="slot"/>
        </div>
    </t>
</template>
