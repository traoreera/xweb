<!--
    Layouts partagés (docs/shell.md, xweb/mount.py) :

    xweb.shell_head     — <head> commun à tous les layouts : CSS compilé,
                          htmx, _hyperscript et le script anti-flash de
                          thème (docs/theming.md). Ce <script> doit rester
                          le PREMIER <script> inline du document et son
                          texte ne doit pas bouger sans régénérer
                          XWEB_THEME_SCRIPT_HASH (xweb/security.py,
                          tests/test_security.py).
    xweb.shell_minimal  — page complète SANS navigation, contenu étroit et
                          centré : écrans d'auth (plugins/account), erreurs
                          avant connexion. Ne pas réutiliser pour autre
                          chose que ce type d'écran — la largeur bridée
                          (max-w-md) casserait toute mise en page plus large.
    xweb.marketing_layout — page complète SANS le chrome applicatif (pas de
                          sidebar/ribbon/palette — ce n'est pas encore "dans
                          l'appli"), mais SANS le plafond de largeur de
                          shell_minimal : bandeau + pied de page, contenu
                          pleine largeur laissé à la page. Utilisé par la
                          landing page ("/", templates/landing.xml, montée
                          depuis main.py — voir integration.yaml, aucun
                          plugin ne peut servir "/" lui-même).
    xweb.theme_toggle   — bouton clair/sombre, _hyperscript vérifié pour de
                          vrai (scripts/verify-hyperscript.mjs).
    xweb.locale_switcher — liens de langue (docs/i18n.md). Contrairement au
                          thème (choix client, localStorage), la traduction
                          se décide AU RENDU côté serveur — chaque lien est
                          une vraie navigation vers ?lang=<code>, jamais un
                          toggle _hyperscript. Invisible tant qu'une seule
                          locale existe (xweb/mount.py::_resolve_translator
                          replie sur ["fr"] sans catalogue configuré).
-->
<templates>

<template t-name="xweb.shell_head">
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title><t t-esc="page_title"/></title>
    <script>document.documentElement.dataset.theme = localStorage.getItem('theme') || 'light';document.documentElement.dataset.sidebar = localStorage.getItem('sidebar') || 'expanded';</script>
    <link rel="icon" href="data:,"/>
    <link rel="stylesheet" href="/xweb-static/app.css"/>
    <script src="/xweb-static/htmx.min.js"></script>
    <script src="/xweb-static/_hyperscript.min.js"></script>
</template>

<template t-name="xweb.sidebar_toggle">
    <t t-set="extra_class" t-default="''"/>
    <!-- Repli/dépli de la sidebar en desktop uniquement (hidden lg:inline-flex
         — sur mobile, c'est déjà un tiroir superposé, replier n'a pas de
         sens). Même mécanique que xweb.theme_toggle : un data-attribut sur
         <html>, persisté en localStorage, relu par le script anti-flash de
         xweb.shell_head AVANT le premier rendu (sinon un flash de sidebar
         dépliée précéderait le repli, le temps que ce bouton s'exécute). -->
    <button type="button" aria-label="Replier/déplier le panneau de navigation" title="Replier/déplier le panneau"
            t-attf-class="btn btn-ghost btn-square btn-sm hidden lg:inline-flex {{extra_class}}"
            _="on click
                 if document.documentElement.dataset.sidebar is 'collapsed' set document.documentElement.dataset.sidebar to 'expanded'
                 else set document.documentElement.dataset.sidebar to 'collapsed'
               end
               then call localStorage.setItem('sidebar', document.documentElement.dataset.sidebar)">
        <t t-call="xweb.icon" name="chevron_left" extra_class="size-4 sidebar-expanded-only"/>
        <t t-call="xweb.icon" name="chevron_right" extra_class="size-4 sidebar-collapsed-only"/>
    </button>
</template>

<template t-name="xweb.theme_toggle">
    <t t-set="id" t-default="'theme-btn'"/>
    <t t-set="extra_class" t-default="''"/>
    <button type="button" t-att-id="id" aria-label="Basculer le thème" title="Thème clair / sombre"
            t-attf-class="btn btn-ghost btn-square btn-sm {{extra_class}}"
            _="on click
                 if document.documentElement.dataset.theme is 'dark' set document.documentElement.dataset.theme to 'light'
                 else set document.documentElement.dataset.theme to 'dark'
               end
               then call localStorage.setItem('theme', document.documentElement.dataset.theme)">
        <t t-call="xweb.icon" name="moon" extra_class="size-5 theme-light-only"/>
        <t t-call="xweb.icon" name="sun" extra_class="size-5 theme-dark-only"/>
    </button>
</template>

<template t-name="xweb.locale_switcher">
    <t t-set="locale" t-default="'fr'"/>
    <t t-set="locales" t-default="['fr']"/>
    <!-- t-default ne rattrape que l'ABSENCE totale du prop, jamais un
         t-att-locales="locales" du site appelant qui résout à None quand
         SON PROPRE contexte n'a pas encore locale/locales (composition
         t-call, docs/language.md#t-call) — "locales and locales[1:]" pour
         ne jamais planter sur un contexte incomplet plutôt que juste sur
         un contexte absent. -->
    <t t-if="locales and locales[1:]">
        <div class="dropdown dropdown-end">
            <div tabindex="0" role="button" class="btn btn-ghost btn-sm px-2 font-mono uppercase" aria-label="Choisir la langue">
                <t t-esc="locale"/>
            </div>
            <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-40 w-28 p-2 shadow-lg border border-base-300">
                <t t-foreach="locales" t-as="code">
                    <li>
                        <a t-att-href="request.url.include_query_params(lang=code)" t-attf-class="font-mono uppercase {{ 'menu-active' if code == locale else '' }}">
                            <t t-esc="code"/>
                        </a>
                    </li>
                </t>
            </ul>
        </div>
    </t>
</template>

<template t-name="xweb.shell_minimal">
<html>
<head><t t-call="xweb.shell_head" t-att-page_title="page_title"/></head>
<body class="min-h-screen bg-base-200 text-base-content flex flex-col">
    <header class="navbar min-h-12 px-4">
        <a href="/" class="text-lg font-semibold tracking-tight"><t t-esc="app_name"/></a>
        <span class="flex-1"></span>
        <t t-call="xweb.locale_switcher" t-att-locale="locale" t-att-locales="locales" t-att-request="request"/>
        <t t-call="xweb.theme_toggle"/>
    </header>
    <main class="flex-1 flex items-start sm:items-center justify-center p-4 pb-12">
        <div class="w-full max-w-md"><t t-out="content"/></div>
    </main>
    <footer class="py-4 text-center text-xs opacity-60"><t t-esc="app_name"/></footer>
</body>
</html>
</template>

<template t-name="xweb.marketing_layout">
<html>
<head><t t-call="xweb.shell_head" t-att-page_title="page_title"/></head>
<body class="min-h-screen bg-base-100 text-base-content flex flex-col">
    <header class="navbar px-4 sm:px-6 lg:px-8 border-b border-base-300 gap-2">
        <a href="/" class="flex items-center gap-2 text-lg font-semibold shrink-0">
            <t t-call="xweb.icon" name="sparkles" extra_class="size-5 text-primary"/>
            <t t-esc="app_name"/>
        </a>
        <span class="flex-1"></span>
        <nav class="hidden sm:flex items-center">
            <a t-attf-href="{{plugin_prefix}}/demo/" class="btn btn-ghost btn-sm" t-tr="1">Démo</a>
        </nav>
        <t t-call="xweb.locale_switcher" t-att-locale="locale" t-att-locales="locales" t-att-request="request"/>
        <t t-call="xweb.theme_toggle"/>
        <t t-if="user">
            <a t-att-href="account_path" class="btn btn-primary btn-sm gap-2">
                <t t-call="xweb.avatar" t-att-initial="account['initial']" size="xs"/>
                <span class="hidden sm:inline">Mon compte</span>
            </a>
        </t>
        <t t-else="1">
            <a t-att-href="login_url" class="btn btn-primary btn-sm">Se connecter</a>
        </t>
    </header>
    <main class="flex-1"><t t-out="content"/></main>
    <footer class="border-t border-base-300 px-4 sm:px-6 lg:px-8 py-6 text-sm opacity-60 flex flex-wrap items-center justify-between gap-2">
        <span><t t-esc="app_name"/></span>
        <span>Propulsé par xweb + xcore</span>
    </footer>
</body>
</html>
</template>

</templates>
