<template t-name="xweb.checkbox">
    <t t-set="value" t-default="''"/>
    <t t-set="label" t-default="''"/>
    <t t-set="description" t-default="''"/>
    <t t-set="name" t-default="''"/>
    <t t-set="checked" t-default="False"/>
    <t t-set="disabled" t-default="False"/>
    <t t-set="extra_class" t-default="''"/>
    <label t-attf-class="flex items-start gap-3 cursor-pointer {{ 'opacity-50 cursor-not-allowed' if disabled else '' }} {{extra_class}}">
        <input type="checkbox" t-att-name="name or None" t-att-value="value or None"
               t-att-checked="checked" t-att-disabled="disabled" class="checkbox mt-0.5"/>
        <t t-if="slot"><t t-out="slot"/></t>
        <t t-elif="label">
            <div class="flex-1">
                <div class="font-medium"><t t-esc="label"/></div>
                <t t-if="description"><div class="text-sm opacity-70 mt-1"><t t-esc="description"/></div></t>
            </div>
        </t>
    </label>
</template>
