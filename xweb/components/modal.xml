<!--
    xweb.modal : <dialog> natif + classes DaisyUI. Ouverture via
    xweb.modal_trigger (_hyperscript, `call #id.showModal()`) ; fermeture par
    les <form method="dialog"> natifs — hx-boost="false" dessus, sinon htmx
    intercepterait la soumission.
-->
<templates>
<template t-name="xweb.modal">
    <t t-set="id" t-default="'xweb-modal'"/>
    <t t-set="title" t-default="''"/>
    <t t-set="actions" t-default="''"/>
    <t t-set="close_label" t-default="'Fermer'"/>
    <t t-set="size" t-default="''"/>
    <t t-set="extra_class" t-default="''"/>
    <dialog t-att-id="id" t-attf-class="modal {{extra_class}}">
        <!-- shadow-none : .modal-box de DaisyUI pose box-shadow:0 25px 50px
             -12px oklch(0% 0/.25) par défaut (vérifié dans le CSS généré) —
             un flottement "carte SaaS" dramatique. shadow-none (utilitaire
             Tailwind, @layer utilities) l'emporte sur la règle DaisyUI
             (@layer components) par priorité de couche CSS, pas par
             spécificité — même mécanisme que le repli de sidebar (voir
             xweb/static/xweb.css). border pour garder une limite nette
             contre le fond assombri, sans ombre. -->
        <div t-attf-class="modal-box shadow-none border border-base-300 {{size}}">
            <form method="dialog" hx-boost="false">
                <button type="submit" class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" aria-label="Fermer">✕</button>
            </form>
            <t t-if="title"><h3 class="text-lg font-semibold mb-3"><t t-esc="title"/></h3></t>
            <div><t t-out="slot"/></div>
            <div class="modal-action">
                <t t-if="actions"><t t-out="actions"/></t>
                <form method="dialog" hx-boost="false"><button type="submit" class="btn"><t t-esc="close_label"/></button></form>
            </div>
        </div>
        <form method="dialog" class="modal-backdrop" hx-boost="false"><button type="submit">fermer</button></form>
    </dialog>
</template>

<template t-name="xweb.modal_trigger">
    <t t-set="target" t-default="'xweb-modal'"/>
    <t t-set="extra_class" t-default="'btn'"/>
    <button type="button" t-attf-class="{{extra_class}}" t-attf-_="on click call #{{target}}.showModal()"><t t-out="slot"/></button>
</template>
</templates>
