<!-- xweb.editable_table — grille éditable en ligne façon Notion, voir
     docs/components.md#editable_table et XWEB_KNOWLEDGE.md §11 pour le
     détail des props et des cinq bugs réels trouvés en la construisant
     (style.display vs classe CSS, opérateurs symboles, hx-target scopé
     par id, hx-vals évalué sur tous les ancêtres, name= requis pour
     qu'une valeur remonte dans une requête htmx). -->
<templates>

<template t-name="xweb.editable_table">
    <t t-set="id" t-default="'xweb-editable-table'"/>
    <t t-set="columns" t-default="[]"/>
    <t t-set="rows" t-default="[]"/>
    <t t-set="save_url" t-default="''"/>
    <t t-set="add_row_url" t-default="''"/>
    <t t-set="delete_row_url" t-default="''"/>
    <t t-set="reorder_url" t-default="''"/>
    <t t-set="add_column_url" t-default="''"/>
    <t t-set="rename_column_url" t-default="''"/>
    <t t-set="extra_class" t-default="''"/>
    
    <!-- Conteneur : zéro bordure visible, juste padding interne -->
    <div t-attf-class="editable-table overflow-visible {{extra_class}}">
        <table class="table table-zebra" style="--tblr-zebra-opacity: 0;">
            <thead>
                <tr>
                    <th class="w-8 opacity-0"></th>
                    <t t-foreach="columns" t-as="col">
                        <t t-call="xweb.editable_table_header_cell" 
                           t-att-col="col" 
                           t-att-rename_column_url="rename_column_url"/>
                    </t>
                    <th class="w-8 opacity-0">
                        <t t-if="add_column_url">
                            <button type="button" class="btn btn-ghost btn-xs btn-square opacity-0 hover:opacity-100 transition-opacity"
                                    aria-label="Ajouter une colonne"
                                    t-att-hx-post="add_column_url"
                                    hx-target="closest .editable-table"
                                    hx-swap="outerHTML">
                                <t t-call="xweb.icon" name="plus" extra_class="size-3"/>
                            </button>
                        </t>
                    </th>
                </tr>
            </thead>
            <tbody t-attf-id="{{id}}-tbody">
                <t t-foreach="rows" t-as="row">
                    <t t-call="xweb.editable_table_row" 
                       t-att-row="row" 
                       t-att-columns="columns"
                       t-att-save_url="save_url" 
                       t-att-delete_row_url="delete_row_url" 
                       t-att-reorder_url="reorder_url"/>
                </t>
            </tbody>
        </table>
        <t t-if="add_row_url">
            <button type="button" class="btn btn-ghost btn-sm w-full justify-start mt-2 text-base-content/60 hover:text-base-content"
                    t-att-hx-post="add_row_url" 
                    t-attf-hx-target="#{{id}}-tbody" 
                    hx-swap="beforeend">
                <t t-call="xweb.icon" name="plus" extra_class="size-4"/>
                <span class="ml-1">Nouvelle ligne</span>
            </button>
        </t>
    </div>
</template>


<template t-name="xweb.editable_table_header_cell">
    <t t-set="col" t-default="{}"/>
    <t t-set="rename_column_url" t-default="''"/>
    <t t-if="not rename_column_url">
        <th class="font-medium text-base-content/70 text-xs uppercase tracking-wide">
            <t t-esc="col.get('label', '')"/>
        </th>
    </t>
    <t t-else="1">
        <th class="font-medium text-base-content/70 text-xs uppercase tracking-wide">
            <span class="cell-display inline px-2 py-1 rounded hover:bg-base-content/5 cursor-text"
                  _="on click hide me then show (next &lt;input/&gt;) then call (next &lt;input/&gt;).focus() then call (next &lt;input/&gt;).select()">
                <t t-esc="col.get('label', '')"/>
            </span>
            <input type="text" class="input input-xs input-ghost w-full font-normal normal-case" 
                   style="display:none"
                   t-att-value="col.get('label', '')"
                   t-attf-hx-patch="{{rename_column_url}}/{{col.get('key')}}"
                   hx-vals="js:{label: event.target.value}"
                   hx-trigger="change, keyup[key=='Enter']" 
                   hx-target="closest th" 
                   hx-swap="outerHTML"
                   _="on blur hide me then show previous &lt;span/&gt;"/>
        </th>
    </t>
</template>


<template t-name="xweb.editable_table_row">
    <t t-set="row" t-default="{}"/>
    <t t-set="columns" t-default="[]"/>
    <t t-set="save_url" t-default="''"/>
    <t t-set="delete_row_url" t-default="''"/>
    <t t-set="reorder_url" t-default="''"/>
    
    <!-- Ligne : hover sur toute la ligne, drag handle visible seulement au hover -->
    <tr t-att-id="row.get('id')" 
        draggable="true"
        t-att-hx-post="reorder_url or None" 
        hx-trigger="table:reordered"
        hx-vals="js:{order: JSON.stringify((event.detail || {}).order || [])}" 
        hx-swap="none"
        class="group hover:bg-base-content/[0.02] transition-colors"
        _="on dragstart call event.dataTransfer.setData('text/plain', my.id) then add .opacity-50 to me
           on dragend remove .opacity-50 from me
           on dragover halt the event then add .border-t-2 .border-primary to me
           on dragleave remove .border-t-2 .border-primary from me
           on drop halt the event then remove .border-t-2 .border-primary from me
              set draggedId to event.dataTransfer.getData('text/plain')
              if draggedId is not my.id and draggedId is not ''
                set draggedRow to document.getElementById(draggedId)
                if draggedRow is not null
                  set rect to my.getBoundingClientRect()
                  if event.clientY &lt; (rect.top + (rect.height / 2))
                    put draggedRow before me
                  else
                    put draggedRow after me
                  end
                  js(me) return Array.from(me.closest('tbody').querySelectorAll('tr')).map(r => r.id) end
                  set orderIds to it
                  send table:reordered(order: orderIds) to me
                end
              end">
        
        <!-- Drag handle : visible seulement au hover de la ligne -->
        <td class="cursor-grab active:cursor-grabbing w-8 text-center opacity-0 group-hover:opacity-40 hover:opacity-80 transition-opacity">
            <t t-call="xweb.icon" name="menu" extra_class="size-3.5"/>
        </td>
        
        <t t-foreach="columns" t-as="col">
            <t t-if="col['type'] == 'select'">
                <t t-call="xweb.editable_table_cell_select" 
                   t-att-row="row" 
                   t-att-col="col" 
                   t-att-save_url="save_url"/>
            </t>
            <t t-elif="col['type'] == 'checkbox'">
                <t t-call="xweb.editable_table_cell_checkbox" 
                   t-att-row="row" 
                   t-att-col="col" 
                   t-att-save_url="save_url"/>
            </t>
            <t t-else="1">
                <t t-call="xweb.editable_table_cell_text" 
                   t-att-row="row" 
                   t-att-col="col" 
                   t-att-save_url="save_url"/>
            </t>
        </t>
        
        <!-- Delete button : visible seulement au hover -->
        <td class="w-8 text-center opacity-0 group-hover:opacity-100 transition-opacity">
            <t t-if="delete_row_url">
                <button type="button" class="btn btn-ghost btn-xs btn-square text-error hover:bg-error/10" 
                        aria-label="Supprimer la ligne"
                        t-attf-hx-delete="{{delete_row_url}}/{{row.get('id')}}" 
                        hx-target="closest tr" 
                        hx-swap="outerHTML">
                    <t t-call="xweb.icon" name="trash" extra_class="size-3.5"/>
                </button>
            </t>
        </td>
    </tr>
</template>


<template t-name="xweb.editable_table_cell_text">
    <t t-set="row" t-default="{}"/>
    <t t-set="col" t-default="{}"/>
    <t t-set="save_url" t-default="''"/>
    <td class="p-0">
        <!-- Cellule texte : padding généreux, zéro bordure, hover discret -->
        <span class="cell-display block px-3 py-2 rounded cursor-text min-h-[36px] text-base-content/90 hover:bg-base-content/[0.03] transition-colors"
              _="on click hide me then show (next &lt;input/&gt;) then call (next &lt;input/&gt;).focus() then call (next &lt;input/&gt;).select()">
            <t t-esc="row.get(col.get('key'), '')"/>
        </span>
        <input type="text" 
               class="input input-ghost w-full px-3 py-2 text-base-content font-normal normal-case bg-transparent" 
               style="display:none"
               t-att-value="row.get(col.get('key'), '')"
               t-attf-hx-patch="{{save_url}}/{{row.get('id')}}"
               t-attf-hx-vals="js:{column: '{{col.get('key')}}', value: event.target.value}"
               hx-trigger="change, keyup[key=='Enter']" 
               hx-target="closest td" 
               hx-swap="outerHTML"
               _="on blur hide me then show previous &lt;span/&gt;"/>
    </td>
</template>


<template t-name="xweb.editable_table_cell_select">
    <t t-set="row" t-default="{}"/>
    <t t-set="col" t-default="{}"/>
    <t t-set="save_url" t-default="''"/>
    <t t-set="current" t-value="row.get(col.get('key'), '')"/>
    <t t-set="options" t-value="col.get('options') or []"/>
    <td class="p-0">
        <input type="hidden" 
               t-attf-id="cell-{{row.get('id')}}-{{col.get('key')}}" 
               t-att-value="current"
               t-attf-hx-patch="{{save_url}}/{{row.get('id')}}"
               t-attf-hx-vals="js:{column: '{{col.get('key')}}', value: event.target.value}"
               hx-trigger="change" 
               hx-target="closest td" 
               hx-swap="outerHTML"/>
        
        <!-- Select : texte simple avec couleur, pas de badge visible -->
        <div class="dropdown dropdown-right">
            <div tabindex="0" 
                 role="button" 
                 class="px-3 py-2 min-h-[36px] flex items-center gap-1.5 cursor-pointer hover:bg-base-content/[0.03] rounded transition-colors w-full">
                <t t-foreach="options" t-as="opt">
                    <t t-if="opt['value'] == current">
                        <!-- Point coloré à gauche, texte simple -->
                        <span t-attf-class="w-2 h-2 rounded-full bg-{{opt.get('color', 'neutral')}}" style="display:inline-block"></span>
                        <span class="text-base-content/90"><t t-esc="opt['label']"/></span>
                    </t>
                </t>
                <t t-if="not current">
                    <span class="text-base-content/40 text-sm">—</span>
                </t>
                <t t-call="xweb.icon" name="chevron_down" extra_class="size-3 text-base-content/40 ml-auto"/>
            </div>
            <ul tabindex="0" 
                class="dropdown-content menu bg-base-100 rounded-lg z-50 w-48 p-1 shadow-xl border border-base-200 mt-1">
                <t t-foreach="options" t-as="opt">
                    <li>
                        <a t-att-data-value="opt['value']"
                           class="flex items-center gap-2 px-3 py-1.5 hover:bg-base-content/[0.04] rounded"
                           t-attf-_="on click
                                        set #cell-{{row.get('id')}}-{{col.get('key')}}.value to my dataset.value
                                        then send change to #cell-{{row.get('id')}}-{{col.get('key')}}">
                            <span t-attf-class="w-2 h-2 rounded-full bg-{{opt.get('color', 'neutral')}}" style="display:inline-block"></span>
                            <span class="text-base-content/90"><t t-esc="opt['label']"/></span>
                        </a>
                    </li>
                </t>
            </ul>
        </div>
    </td>
</template>


<template t-name="xweb.editable_table_cell_checkbox">
    <t t-set="row" t-default="{}"/>
    <t t-set="col" t-default="{}"/>
    <t t-set="save_url" t-default="''"/>
    <td class="text-center p-0">
        <input type="checkbox" 
               class="checkbox checkbox-xs rounded" 
               style="accent-color: var(--color-primary);"
               t-att-checked="row.get(col.get('key'), False)"
               t-attf-hx-patch="{{save_url}}/{{row.get('id')}}"
               t-attf-hx-vals="js:{column: '{{col.get('key')}}', value: event.target.checked}"
               hx-trigger="change" 
               hx-target="closest td" 
               hx-swap="outerHTML"/>
    </td>
</template>


</templates>
