<!-- Champ mot de passe avec bascule afficher/masquer (_hyperscript, vérifié dans scripts/verify-hyperscript.mjs). -->
<template t-name="xweb.password">
    <t t-set="name" t-default="'password'"/>
    <t t-set="id" t-default="name"/>
    <t t-set="placeholder" t-default="''"/>
    <t t-set="autocomplete" t-default="'current-password'"/>
    <t t-set="required" t-default="True"/>
    <t t-set="minlength" t-default="None"/>
    <t t-set="invalid" t-default="False"/>
    <t t-set="extra_class" t-default="''"/>
    <label t-attf-class="input w-full {{ 'input-error' if invalid else '' }} {{extra_class}}">
        <t t-call="xweb.icon" name="lock" extra_class="size-4 opacity-60"/>
        <input type="password" t-att-id="id" t-att-name="name" t-att-placeholder="placeholder or None"
               t-att-autocomplete="autocomplete" t-att-required="required" t-att-minlength="minlength" class="grow"/>
        <button type="button" class="btn btn-ghost btn-xs btn-square" aria-label="Afficher ou masquer le mot de passe" tabindex="-1"
                t-attf-_="on click if #{{id}}'s type is 'password' set #{{id}}'s type to 'text' else set #{{id}}'s type to 'password' end">
            <t t-call="xweb.icon" name="eye" extra_class="size-4 opacity-60"/>
        </button>
    </label>
</template>
