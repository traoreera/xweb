<!--
    xweb.pdf_document — layout d'export PDF (docs/pdf.md, xweb/pdf.py).

    Volontairement indépendant de xweb.shell_head/app.css : WeasyPrint (qui
    fait le rendu final HTML -> PDF, voir xweb/pdf.py) ne supporte ni les
    couleurs oklch()/color-mix() ni @layer, tous les deux utilisés par
    Tailwind v4/DaisyUI — brancher ce layout sur app.css produirait un PDF
    blanc sans la moindre erreur. Feuille de style inline, en couleurs hex
    plates, volontairement minimale (pas de dark mode : un PDF imprimé n'a
    pas de thème).

    Props : page_title, app_name, generated_at (déjà formaté côté vue —
    aucun strftime()/datetime disponible dans une expression de template,
    voir CLAUDE.md "aucun builtin"), content (injecté par render_pdf()).
-->
<templates>

<template t-name="xweb.pdf_document">
<html>
<head>
    <meta charset="utf-8"/>
    <title><t t-esc="page_title"/></title>
    <style>
        @page {
            size: A4;
            margin: 2cm 1.5cm;
            @bottom-center { content: counter(page) " / " counter(pages); font-size: 9px; color: #6b7280; }
        }
        * { box-sizing: border-box; }
        body { font-family: "DejaVu Sans", Helvetica, Arial, sans-serif; font-size: 11px; color: #111827; margin: 0; }
        header.pdf-header { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 2px solid #111827; padding-bottom: 8px; margin-bottom: 16px; }
        header.pdf-header h1 { font-size: 16px; margin: 0; }
        header.pdf-header .pdf-meta { font-size: 10px; color: #6b7280; text-align: right; }
        table { width: 100%; border-collapse: collapse; }
        th, td { text-align: left; padding: 4px 6px; border-bottom: 1px solid #e5e7eb; vertical-align: top; }
        th { background: #f3f4f6; font-size: 10px; text-transform: uppercase; letter-spacing: .03em; }
        tr { page-break-inside: avoid; }
        .pdf-empty { color: #6b7280; font-style: italic; padding: 24px 0; }
        .pdf-mono { font-family: "DejaVu Sans Mono", monospace; }
    </style>
</head>
<body>
    <header class="pdf-header">
        <h1><t t-esc="page_title"/></h1>
        <div class="pdf-meta">
            <div><t t-esc="app_name"/></div>
            <div><t t-esc="generated_at"/></div>
        </div>
    </header>
    <t t-out="content"/>
</body>
</html>
</template>

</templates>
