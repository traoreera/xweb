<!-- bordered=False saute le conteneur DaisyUI "stats"/"stat" (fond, bordure,
     padding fixes) et rend title/value/desc nus avec les mêmes classes
     stat-title/stat-value/stat-desc — de simples classes de typographie
     DaisyUI, leur style visuel ne dépend pas de la boîte englobante
     (know/features/stat-minimal-variant.md). Défaut True : rien ne change
     pour un appelant existant. -->
<template t-name="xweb.stat">
    <t t-set="title" t-default="''"/>
    <t t-set="value" t-default="''"/>
    <t t-set="desc" t-default="''"/>
    <t t-set="icon" t-default="''"/>
    <t t-set="color" t-default="'primary'"/>
    <t t-set="bordered" t-default="True"/>
    <t t-set="extra_class" t-default="''"/>
    <t t-if="bordered">
        <div t-attf-class="stats bg-base-100 border border-base-300 {{extra_class}}">
            <div class="stat">
                <t t-if="icon"><div t-attf-class="stat-figure text-{{color}}"><t t-call="xweb.icon" t-att-name="icon" extra_class="size-8"/></div></t>
                <div class="stat-title"><t t-esc="title"/></div>
                <div class="stat-value"><t t-esc="value"/></div>
                <t t-if="desc"><div class="stat-desc"><t t-esc="desc"/></div></t>
                <t t-out="slot"/>
            </div>
        </div>
    </t>
    <t t-else="1">
        <div t-attf-class="{{extra_class}}">
            <t t-if="icon"><div t-attf-class="text-{{color}}"><t t-call="xweb.icon" t-att-name="icon" extra_class="size-8"/></div></t>
            <div class="stat-title"><t t-esc="title"/></div>
            <div class="stat-value"><t t-esc="value"/></div>
            <t t-if="desc"><div class="stat-desc"><t t-esc="desc"/></div></t>
            <t t-out="slot"/>
        </div>
    </t>
</template>
